# Sandbox app environment (copied to .env.localtest by scripts/sandbox-test.sh,
# which fills JWT_SECRET and SUPER_ADMIN_PASSWORD with random values).
# Sandbox only: never reuse production secrets here.
JWT_SECRET=__RANDOM__
JWT_EXPIRES_IN=8h
SUPER_ADMIN_NAME=Sandbox Admin
SUPER_ADMIN_EMAIL=sandbox-admin@local.test
SUPER_ADMIN_PASSWORD=__RANDOM__
CORS_ORIGINS=http://localhost:3300
