# Server-side deploy config. On the droplet, copy to deploy/server.env (gitignored).
# Run `./scripts/deploy-remote.sh --check <tag>` first: it validates every value
# below against the running stack and changes nothing.

# Exact compose arguments that manage the RUNNING production stack.
# With Cloudflare tunnel:
COMPOSE_ARGS="--env-file .env.production -f docker-compose.prod.yml -f docker-compose.tunnel.yml"
# Without tunnel (Caddy on 80/443):
# COMPOSE_ARGS="--env-file .env.production -f docker-compose.prod.yml"

# Name of the running Postgres container (see `docker ps`).
DB_CONTAINER=pwa_gorjetas-db-1

# Env file holding POSTGRES_USER / POSTGRES_DB.
ENV_FILE=.env.production

# Backups written by deploys and copies of anything git would remove.
# MUST be outside the git clone so git can never delete them.
SAFE_BACKUP_DIR=/home/yourlab/pwa_gorjetas_safe_backups

# Minimum free disk (GB) required before building.
MIN_FREE_GB=3

# Use "sudo docker" if the deploy user is not in the docker group.
DOCKER="docker"

# Space-separated migration folder names explicitly approved by the owner
# despite containing DROP/TRUNCATE/DELETE/UPDATE/RENAME/type changes. Normally empty.
APPROVED_MIGRATIONS=""
